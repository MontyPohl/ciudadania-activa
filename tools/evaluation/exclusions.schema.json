{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ciudadania-activa:s15:exclusions:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "s15-exclusions-v1"
    },
    "scene_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      },
      "uniqueItems": true
    },
    "origin_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
      },
      "uniqueItems": true
    },
    "original_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "normalized_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "scene_ids",
    "origin_ids",
    "original_sha256",
    "normalized_sha256"
  ],
  "additionalProperties": false
}
