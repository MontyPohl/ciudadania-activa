{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ciudadania-activa:s15:responses:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "s15-responses-v1"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "enum": [
        "offline-fixture",
        "frozen-provider-response"
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "attempt": {
            "const": 1
          },
          "status": {
            "enum": [
              "response",
              "timeout",
              "provider_error",
              "missing",
              "interrupted"
            ]
          },
          "raw_response": {
            "type": [
              "string",
              "null"
            ]
          },
          "returned_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens"
            ],
            "additionalProperties": false
          },
          "elapsed_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "case_id",
          "attempt",
          "status",
          "raw_response",
          "returned_model",
          "usage",
          "elapsed_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_sha256",
    "source",
    "responses"
  ],
  "additionalProperties": false
}
