# Copiar como .env (nunca versionar .env). Uso: docker compose --env-file ../.env,
# manage.py runserver local y next dev leen estas mismas variables.
#
# Este archivo describe el entorno LOCAL. Las credenciales de Supabase van en
# .env.supabase.local (ignorado por Git), que solo se usa para verificaciones puntuales
# con un contenedor efímero; ver README. Nunca se versiona ningún valor real.

# --- Django ---
DJANGO_SECRET_KEY=changeme-local-dev-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
API_VERSION=0.1.0

# --- Base de datos (PostgreSQL + PostGIS, alojada en Supabase — D-03/ADR-0003) ---
# Este .env representa el DESARROLLO LOCAL: apunta al contenedor de infra/docker-compose.yml.
# Para verificar contra Supabase NO se edita este archivo; se usa .env.supabase.local
# (ignorado por Git) con un contenedor efímero. Ver README, "Verificación contra Supabase".
DATABASE_URL=postgis://ciudadania:ciudadania@localhost:5432/ciudadania_activa

# Esquemas donde Django debe buscar tipos y funciones. PostGIS está en `gis` en Supabase y
# en `public` en el contenedor local; el valor por defecto cubre ambos casos y PostgreSQL
# ignora sin error los esquemas que no existan. Normalmente no hace falta cambiarlo.
DB_SEARCH_PATH=public,gis,extensions

# --- Redis (caché y broker de Celery) ---
REDIS_URL=redis://localhost:6379/0
# TTL corto de listados del mapa público. El detalle no se cachea.
PUBLIC_MAP_CACHE_TTL_SECONDS=60

# --- CORS (dominio del frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google Identity Services (Sprint 3) ---
# El Client ID no es un secreto: es el `audience` que el backend exige en el ID token y
# el mismo valor que el navegador necesita para pintar el botón de Google. Se configura
# en el backend (Railway) y, con el prefijo NEXT_PUBLIC_, en el frontend (Vercel).
# El flujo aprobado es ID token / credential, no Authorization Code: por eso no hay
# client secret ni redirect URI. Ver ADR-0005.
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- JWT propio (opcional; estos son los valores por defecto) ---
# La firma usa DJANGO_SECRET_KEY, así que no hace falta un secreto adicional.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Verificación de identidad (Sprint 4): HMAC-SHA-256 de la cédula ---
# Clave con la que se calcula `citizen_profiles.document_hmac`. Solo la necesita el
# BACKEND WEB; el worker de Celery no la usa y no debe recibirla.
#
# CADA ENTORNO TIENE LA SUYA: desarrollo la suya, la suite de pruebas una ficticia, y
# producción la real, que no se comparte con desarrollo ni con CI. Alta entropía.
#
# LA DE PRODUCCIÓN DEBE PERMANECER ESTABLE una vez exista la primera identidad
# verificada real: cambiarla invalida todos los `document_hmac` ya calculados y no hay
# forma de recalcularlos, porque el número de cédula no se guarda en claro. Ver ADR-0006.
#
# Nunca se versiona un valor real aquí.
DOCUMENT_HMAC_SECRET=

# --- Supabase Storage (buckets privados de verificación y reportes) ---
# Solo el BACKEND WEB. `SUPABASE_SERVICE_ROLE_KEY` tiene privilegios totales sobre el
# almacenamiento: no va en el worker, no va en Vercel y no se versiona.
#
# El frontend NO habla con Supabase: no existe ninguna variable NEXT_PUBLIC_SUPABASE_*.
# La selfie se sube a Django, y para verla el administrador recibe de Django una URL
# firmada de vida corta.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket PRIVADO de verificación. No es un secreto: es un nombre. El bucket
# debe existir y no admitir acceso anónimo. En PostgreSQL se guarda la clave del objeto
# (`verifications/{user_id}/{uuid4}.{ext}`), nunca una URL.
SUPABASE_STORAGE_BUCKET_PRIVATE=verificaciones

# Bucket PRIVADO separado para fotos de reportes. El backend persiste únicamente
# `reports/{report_id}/{media_id}.{ext}`; no guarda URLs públicas ni firmadas.
SUPABASE_STORAGE_BUCKET_REPORTS=reportes

# --- Google Gemini (clasificación asistida por IA, Sprint 8) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Email transaccional: Brevo por API HTTPS (notifications_app) ---
# Configuración del WORKER DE CELERY, que es quien envía. El backend web solo escribe la
# fila en `notifications`, así que no necesita esta clave para arrancar ni para
# funcionar. Sin ella la notificación queda en FALLIDO, que es un estado previsto y
# consultable, no una caída del servicio.
#
# NO SE USA SMTP. El plan Free de Railway no ofrece SMTP saliente: la conexión se queda
# colgada hasta el timeout. El envío va contra `POST https://api.brevo.com/v3/smtp/email`
# por el puerto 443. Ver ADR-0015.
#
# BREVO_API_KEY es una clave de API v3 de Brevo (SMTP & API > API Keys), NO la clave
# SMTP: son credenciales distintas y la SMTP no autentica contra esta API. Es un secreto:
# nunca se versiona un valor real aquí, y solo se configura en el worker.
BREVO_API_KEY=

# Endpoint del envío. Se deja explícito para poder apuntarlo a un doble en pruebas; en
# producción se omite y rige el valor por defecto.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Remitente. Admite `Nombre <direccion>`. La dirección debe estar dada de alta como
# REMITENTE VERIFICADO en Brevo o el envío se rechaza. Valor de producción:
# `Ciudadanía Activa <ciudadaniaactiva02@gmail.com>`.
DEFAULT_FROM_EMAIL=no-reply@ciudadania-activa.local

# --- Reglas de dominio parametrizables ---
REPORT_DUPLICATE_RADIUS_METERS=100
REPORT_AUTO_CLOSE_HOURS=72

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
